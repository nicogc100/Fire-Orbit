{
  "name": "fire-sat",
  "version": "1.0.0",
  "private": true,
  "description": "Fire Sat: globo 3D con detecciones de incendios de NASA FIRMS (MODIS y VIIRS).",
  "type": "module",
  "scripts": {
    "start": "python globo-incendios/iniciar.py --tierra",
    "test": "node --test \"globo-incendios/pruebas/*.test.mjs\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "versionar": "node globo-incendios/herramientas/versionar.mjs",
    "versionar:check": "node globo-incendios/herramientas/versionar.mjs --comprobar",
    "check": "npm run format:check && npm run lint && npm run versionar:check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "prettier": "^3.9.10"
  }
}
